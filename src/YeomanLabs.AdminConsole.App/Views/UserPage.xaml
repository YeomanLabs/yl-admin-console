<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels"
                    xmlns:pages="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels.Pages">
    <!-- User 360 (UX §4). Merged after Theme.xaml and PageTemplates.xaml (uses SkeletonBlock from there). -->

    <!-- Header badge with tone colours. Coral is never used for badges (UX §1). -->
    <DataTemplate x:Key="HeaderBadge" DataType="{x:Type vm:BadgeItem}">
        <Border x:Name="Chip" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" BorderThickness="1" ToolTip="{Binding ToolTip}"
                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <TextBlock x:Name="Label" Text="{Binding Text}" FontSize="12" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsGood}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource YlSuccess}" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource YlSuccess}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="#E0A030" />
                <Setter TargetName="Label" Property="Foreground" Value="#E0A030" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource YlDanger}" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource YlDanger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsInfo}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="#4A9EE0" />
                <Setter TargetName="Label" Property="Foreground" Value="#4A9EE0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Mono value that copies itself on click (UX §4: UPN / object ID click to copy). -->
    <Style x:Key="CopyableMono" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource YlMono}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ToolTip" Value="Click to copy" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <ui:SymbolIcon x:Name="Icon" Symbol="Copy24" FontSize="12" Margin="6,0,0,0" Opacity="0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FactLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Margin" Value="0,10,0,1" />
    </Style>

    <Style x:Key="FactValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TabPlaceholder" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <DataTemplate DataType="{x:Type pages:UserDetailViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Main column: header + tabs -->
            <Grid Grid.Column="0" Margin="24,16,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header (UX §4): avatar · name · UPN · badges | primary actions -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource YlRailBackground}"
                            BorderBrush="{StaticResource YlCoral}" BorderThickness="2" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                        <Button Style="{StaticResource CopyableMono}" Content="{Binding User.UserPrincipalName}"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding User.UserPrincipalName}"
                                AutomationProperties.Name="Copy user principal name" Margin="-4,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource HeaderBadge}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="6,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsHydrating, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HydrateError}" FontSize="12" Foreground="{StaticResource YlDanger}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HydrateError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Primary actions; greyed with the UX §6 inline caption until M5/M6 wire them -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Reset password" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                            <ui:Button Content="Revoke sessions" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                            <ui:Button Content="Offboard…" Appearance="Primary" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                            <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" IsEnabled="False" ToolTip="More actions" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="More actions" />
                            <ui:Button Icon="{ui:SymbolIcon PanelRight24}" Command="{Binding ToggleSidebarCommand}" ToolTip="Toggle quick facts" AutomationProperties.Name="Toggle quick facts" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActionsDisabledReason}" FontSize="11" Opacity="0.5" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Identity">
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TabPlaceholder}" Text="Identity fields render in M4.3." />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUser}" Value="False">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Access">
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TabPlaceholder}" Text="Licenses, groups, roles and auth methods render in M4.3." />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAccessLoaded}" Value="False">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Devices">
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TabPlaceholder}" Text="Device cards render in M4.3." />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUser}" Value="False">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Activity">
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TabPlaceholder}" Text="Sign-in activity renders in M4.3." />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActivityLoaded}" Value="False">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Mailbox" IsEnabled="False" ToolTip="{Binding MailboxDisabledReason}" ToolTipService.ShowOnDisabled="True" />
                </TabControl>
            </Grid>

            <!-- Sidebar (UX §4): 280 px quick facts, collapsible -->
            <Border Grid.Column="1" Width="280" Background="{StaticResource YlRailBackground}" Padding="16,16,16,8"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Quick facts" FontWeight="SemiBold" />

                        <TextBlock Style="{StaticResource FactLabel}" Text="Object ID" />
                        <Button Style="{StaticResource CopyableMono}" FontSize="11"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding Id}" AutomationProperties.Name="Copy object ID" Margin="-4,0,0,0">
                            <TextBlock Text="{Binding Id}" TextWrapping="Wrap" MaxWidth="220" />
                        </Button>

                        <TextBlock Style="{StaticResource FactLabel}" Text="Created" />
                        <TextBlock Style="{StaticResource FactValue}" Text="{Binding CreatedText}" />

                        <StackPanel Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="Last sync from on-prem" />
                            <TextBlock Style="{StaticResource FactValue}" Text="{Binding LastSyncText}" />
                            <TextBlock Style="{StaticResource FactLabel}" Text="Source anchor" />
                            <Button Style="{StaticResource CopyableMono}" Content="{Binding SourceAnchor}" FontSize="12"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding SourceAnchor}" AutomationProperties.Name="Copy source anchor" Margin="-4,0,0,0" />
                            <TextBlock Style="{StaticResource FactLabel}" Text="On-prem DN" />
                            <Button Style="{StaticResource CopyableMono}" Content="{Binding OnPremDn}" FontSize="12"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding OnPremDn}" AutomationProperties.Name="Copy distinguished name" Margin="-4,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FactLabel}" Text="Manager" />
                        <TextBlock Style="{StaticResource FactValue}" Text="{Binding ManagerText}" />

                        <TextBlock Style="{StaticResource FactLabel}" Text="Direct reports" />
                        <TextBlock Style="{StaticResource FactValue}" Text="{Binding DirectReportsText}" />

                        <TextBlock Style="{StaticResource FactLabel}" Text="Loaded" />
                        <TextBlock Style="{StaticResource FactValue}" Text="{Binding TimingText}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
