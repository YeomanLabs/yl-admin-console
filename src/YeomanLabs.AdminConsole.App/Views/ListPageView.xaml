<UserControl x:Class="YeomanLabs.AdminConsole.App.Views.ListPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pages="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels.Pages"
             x:Name="Root">
    <!-- Bottom margin leaves the toast stack (UX §10, bottom-right) somewhere to sit that is not on the list. -->
    <Grid Margin="24,16,24,56">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <!-- Live region: the count is how a screen-reader user knows a filter did anything. -->
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding CountText}" />
                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Loading"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Margin="0,0,8,0" PlaceholderText="{Binding SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.Name="{Binding SearchPlaceholder}" />
            <TextBlock Foreground="{DynamicResource YlTextSecondary}" Grid.Column="1" Text="Sort by" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="2" MinWidth="140" Margin="0,0,10,0" ItemsSource="{Binding Sorts}"
                      SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Sort the list by" />
            <CheckBox Grid.Column="3" IsChecked="{Binding Descending}" Content="Reverse" VerticalAlignment="Center"
                      AutomationProperties.Name="Reverse the sort order" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding ChipGroups}" AutomationProperties.Name="Filters">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:FilterChipGroup}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <ItemsControl ItemsSource="{Binding Chips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:FilterChip}">
                                        <!-- The name carries the count so a screen reader hears "Disabled, 2 matching"
                                             rather than a bare label it cannot judge. -->
                                        <ToggleButton IsChecked="{Binding IsOn}" Style="{StaticResource FilterChipStyle}"
                                                      ToolTip="{Binding Description}"
                                                      AutomationProperties.Name="{Binding AccessibleName}"
                                                      AutomationProperties.HelpText="{Binding Description}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding CountText}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Width="1" Margin="2,2,8,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:HyperlinkButton Content="Clear all filters" Padding="0" HorizontalAlignment="Left" FontSize="12"
                                Command="{Binding ClearFiltersCommand}"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Clear all filters" />
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="6" Padding="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- UX §6: an empty list says why it is empty and what to do about it. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="20"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding EmptyTitle}" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding EmptyHint}" FontSize="12" Margin="0,6,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <ui:Button Content="Clear the filters" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Command="{Binding ClearFiltersCommand}"
                               Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ContentPresenter Content="{Binding RowsContent, ElementName=Root}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <ui:Button Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Center" Content="Load more"
                   Command="{Binding LoadMoreCommand}"
                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.Name="Load more results" />
    </Grid>
</UserControl>
