<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:pages="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels.Pages"
                    xmlns:models="clr-namespace:YeomanLabs.AdminConsole.Core.Models;assembly=YeomanLabs.AdminConsole.Core">
    <!-- Device page (UX §5). Merged after UserPage.xaml: reuses HeaderBadge, Chip, CopyableMono, FactLabel/FactValue, SectionTitle, Caption. -->

    <!-- Read-only fact row; mono values are click-to-copy -->
    <DataTemplate x:Key="DeviceFactRow" DataType="{x:Type pages:IdentityField}">
        <Grid Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Opacity="0.65" VerticalAlignment="Center" />
            <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="Mono" Grid.Column="1" Style="{StaticResource CopyableMono}" Content="{Binding Value}" FontSize="12" Visibility="Collapsed"
                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding Value}"
                    AutomationProperties.Name="{Binding Label}" Margin="-4,0,0,0" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasValue}" Value="False">
                <Setter TargetName="Value" Property="Opacity" Value="0.35" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMono}" Value="True" />
                    <Condition Binding="{Binding HasValue}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Mono" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="PersonCard" DataType="{x:Type models:PersonRef}">
        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left"
                Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding Label}">
            <Border Padding="12,8" CornerRadius="6" MinWidth="260" Margin="0,0,12,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UserPrincipalName}" FontFamily="{StaticResource YlMono}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="PolicyRow" DataType="{x:Type models:CompliancePolicyState}">
        <StackPanel Margin="0,0,0,6">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PlatformType}" FontSize="11" Opacity="0.45" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Border x:Name="StateChip" Grid.Column="2" Style="{StaticResource Chip}" Margin="0">
                    <TextBlock x:Name="StateLabel" Text="{Binding State}" FontSize="11" />
                </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding SettingStates}" Margin="16,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ComplianceSettingState}">
                        <StackPanel Orientation="Horizontal" Height="24">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="12" Foreground="{StaticResource YlDanger}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorDescription}" FontSize="12" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding ErrorDescription, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCompliant}" Value="True">
                <Setter TargetName="StateChip" Property="BorderBrush" Value="{StaticResource YlSuccess}" />
                <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource YlSuccess}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsReason}" Value="True">
                <Setter TargetName="StateChip" Property="BorderBrush" Value="{StaticResource YlDanger}" />
                <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource YlDanger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:DeviceDetailViewModel}">
        <Grid Margin="24,16,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: name · model · serial (copy) · badges | Sync / Restart / Retire… / Wipe… (greyed until M5.6) -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource YlRailBackground}"
                        BorderBrush="{StaticResource YlCoral}" BorderThickness="2" VerticalAlignment="Top" Margin="0,2,14,0">
                    <ui:SymbolIcon Symbol="Laptop24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.7" VerticalAlignment="Center" />
                        <Button Style="{StaticResource CopyableMono}" Content="{Binding Device.SerialNumber}" Margin="8,0,0,0"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding Device.SerialNumber}" AutomationProperties.Name="Copy serial number" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource HeaderBadge}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="6,0,6,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsHydrating, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HydrateError}" FontSize="12" Foreground="{StaticResource YlDanger}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HydrateError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Sync" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                        <ui:Button Content="Restart" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                        <ui:Button Content="Retire…" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                        <ui:Button Content="Wipe…" Appearance="Danger" IsEnabled="False" ToolTip="{Binding ActionsDisabledReason}" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActionsDisabledReason}" FontSize="11" Opacity="0.5" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TimingText}" FontSize="11" Opacity="0.45" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,16">
                    <!-- Overview -->
                    <TextBlock Text="Overview" Style="{StaticResource SectionTitle}" />
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Overview}" ItemTemplate="{StaticResource DeviceFactRow}" />
                                                <ui:HyperlinkButton Content="Open the Entra device object in the portal" Command="{Binding OpenInEntraPortalCommand}" Padding="0" Margin="170,4,0,0"
                                                                    Visibility="{Binding HasEntraObject, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevice}" Value="False">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- People -->
                    <TextBlock Text="People" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding PeopleCaption}" Style="{StaticResource Caption}" Margin="0,0,0,6" Visibility="{Binding PeopleCaption, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="Primary user" FontSize="11" Opacity="0.55" Margin="0,0,0,4" Visibility="{Binding PrimaryUser, Converter={StaticResource NullToCollapsed}}" />
                    <ContentControl Content="{Binding PrimaryUser}" ContentTemplate="{StaticResource PersonCard}" HorizontalAlignment="Left"
                                    Visibility="{Binding PrimaryUser, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Visibility="{Binding OtherUsers.Count, Converter={StaticResource NonZeroToVisible}}">
                        <TextBlock Text="Other registered users" FontSize="11" Opacity="0.55" Margin="0,6,0,4" />
                        <ItemsControl ItemsSource="{Binding OtherUsers}" ItemTemplate="{StaticResource PersonCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Hardware -->
                    <TextBlock Text="Hardware" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource DeviceFactRow}" />

                    <!-- Security: reveal buttons present but greyed with the UX §6 reason (M5.6 wires them) -->
                    <TextBlock Text="Security" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="BitLocker recovery keys" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="Reveal" Icon="{ui:SymbolIcon Key24}" IsEnabled="False" ToolTip="{Binding BitLockerReason}" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="{Binding BitLockerReason}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="LAPS password" Opacity="0.65" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Reveal" Icon="{ui:SymbolIcon Key24}" IsEnabled="False" ToolTip="{Binding LapsReason}" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="{Binding LapsReason}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Compliance per policy with reason on failure -->
                    <TextBlock Text="Compliance" Style="{StaticResource SectionTitle}" />
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ComplianceCaption}" Style="{StaticResource Caption}" Visibility="{Binding ComplianceCaption, Converter={StaticResource NullToCollapsed}}" />
                                                <ItemsControl ItemsSource="{Binding Policies}" ItemTemplate="{StaticResource PolicyRow}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComplianceLoaded}" Value="False">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
