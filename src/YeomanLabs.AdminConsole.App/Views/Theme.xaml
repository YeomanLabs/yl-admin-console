<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:YeomanLabs.AdminConsole.App.Converters">
    <!-- Merged before PageTemplates.xaml: StaticResource inside a merged dictionary only sees dictionaries merged earlier. -->

    <!-- UX §1 palette: navy window base, coral accent for primary actions, focus rings and the active nav item only. -->
    <Color x:Key="YlNavyColor">#041635</Color>
    <Color x:Key="YlCoralColor">#FF6950</Color>
    <SolidColorBrush x:Key="YlNavy" Color="{StaticResource YlNavyColor}" />
    <SolidColorBrush x:Key="YlCoral" Color="{StaticResource YlCoralColor}" />
    <SolidColorBrush x:Key="YlCoralDim" Color="#B3FF6950" />
    <SolidColorBrush x:Key="YlRailBackground" Color="#0A1F45" />
    <SolidColorBrush x:Key="YlSuccess" Color="#4CC38A" />
    <SolidColorBrush x:Key="YlDanger" Color="#F04E4E" />
    <FontFamily x:Key="YlMono">Cascadia Mono, Consolas</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:NullToBoolConverter x:Key="NullToBool" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="ZeroToVisible" />
    <conv:CountToVisibilityConverter x:Key="NonZeroToVisible" WhenNonZero="True" />
</ResourceDictionary>
