<ui:FluentWindow x:Class="YeomanLabs.AdminConsole.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="Admin Console"
                 Width="1280" Height="800" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource YlNavy}">
    <!-- UX §1: Mica/acrylic off (performance, RDP). Layout per UX §2; M3.2 fills the rail, content and status bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Admin Console" ShowMaximize="True" ShowMinimize="True" />

        <!-- Non-modal error bar targeted by the global exception handler (never crash silently). -->
        <ui:InfoBar Grid.Row="1" Margin="12,4,12,0"
                    Severity="Error"
                    IsOpen="{Binding HasError, Mode=OneWay}"
                    IsClosable="False"
                    Title="{Binding ErrorTitle}"
                    Message="{Binding ErrorMessage}">
            <ui:InfoBar.Content>
                <StackPanel>
                    <Expander Header="Details" Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                                 FontFamily="{StaticResource YlMono}" FontSize="12" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Content="Copy details" Command="{Binding CopyErrorDetailsCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Dismiss" Command="{Binding DismissErrorCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!-- M3.2 replaces this with the nav rail + content region + status bar. -->
        <TextBlock Grid.Row="2" Margin="24" Text="Host is up. Shell arrives in M3.2." Opacity="0.6" />
    </Grid>
</ui:FluentWindow>
