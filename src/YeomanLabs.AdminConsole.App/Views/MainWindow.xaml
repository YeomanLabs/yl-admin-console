<ui:FluentWindow x:Class="YeomanLabs.AdminConsole.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels"
                 xmlns:views="clr-namespace:YeomanLabs.AdminConsole.App.Views"
                 xmlns:b="clr-namespace:YeomanLabs.AdminConsole.App.Behaviors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="Admin Console"
                 Width="1280" Height="800" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <!-- UX §1: Mica/acrylic off. UX §2 layout: title bar / nav rail + content / status bar. -->
    <ui:FluentWindow.Resources>
        <!-- Nav rail button: 48 px square, coral indicator on the active item (UX §1: coral only for accent/active). -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Indicator" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{StaticResource YlCoral}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavRailItem" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource NavRailButton}" ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" />
            </Button>
        </DataTemplate>

        <!-- Sync status pill -->
        <Style x:Key="SyncDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncState}" Value="Syncing">
                    <Setter Property="Fill" Value="{StaticResource YlCoral}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SyncState}" Value="Ok">
                    <Setter Property="Fill" Value="#4CC38A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SyncState}" Value="Error">
                    <Setter Property="Fill" Value="#F04E4E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- UX §11 keyboard table. Alt+1..6 nav, Alt+← back, Ctrl+T/W/Tab tabs, Ctrl+K palette, Ctrl+N new user, F5 refresh, Ctrl+Shift+S sync, Ctrl+, settings. -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewUserCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding NewTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Tab" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SyncNowCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Modifiers="Alt" Key="D1" Command="{Binding NavigateOrdinalCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Alt" Key="D2" Command="{Binding NavigateOrdinalCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Alt" Key="D3" Command="{Binding NavigateOrdinalCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Alt" Key="D4" Command="{Binding NavigateOrdinalCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Alt" Key="D5" Command="{Binding NavigateOrdinalCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Alt" Key="D6" Command="{Binding NavigateOrdinalCommand}" CommandParameter="6" />
        <!-- Esc closes a modal wherever focus is; the palette handles its own Esc on the search box first. -->
        <KeyBinding Key="Escape" Command="{Binding Dialogs.Current.CancelCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid Background="{StaticResource YlNavy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: app name · tenant · sync pill · account (UX §2) -->
        <ui:TitleBar Grid.Row="0" Title="Admin Console" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                    <TextBlock Text="{Binding TenantName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            AutomationProperties.Name="Sync status">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource SyncDot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Width="24" Height="24" VerticalAlignment="Center"
                            Background="{StaticResource YlCoral}" ToolTip="{Binding AccountName}"
                            AutomationProperties.Name="Signed-in account">
                        <TextBlock Text="{Binding AccountInitials}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#041635" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Non-modal error bar targeted by the global exception handler (never crash silently). -->
        <ui:InfoBar Grid.Row="1" Margin="60,4,12,4"
                    Severity="Error"
                    IsOpen="{Binding HasError, Mode=OneWay}"
                    IsClosable="False"
                    Title="{Binding ErrorTitle}"
                    Message="{Binding ErrorMessage}">
            <ui:InfoBar.Content>
                <StackPanel>
                    <Expander Header="Details" Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                                 FontFamily="{StaticResource YlMono}" FontSize="12" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Content="Copy details" Command="{Binding CopyErrorDetailsCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Dismiss" Command="{Binding DismissErrorCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!-- Nav rail + content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#0A1F45" Visibility="{Binding IsSessionReady, Converter={StaticResource BoolToVisibility}}">
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsItem}" ContentTemplate="{StaticResource NavRailItem}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavRailItem}" Margin="0,4,0,0" />
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab strip (UX §11: Ctrl+T/W/Tab). Collapsed with a single tab to keep the density. -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" Margin="8,0,0,0"
                              Visibility="{Binding HasMultipleTabs, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WorkspaceTab}">
                            <Border x:Name="TabChrome" CornerRadius="6,6,0,0" Padding="12,0,4,0" Height="32" Margin="0,4,2,0"
                                    Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8,0,0,0">
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar: cache age · last delta · errors · progress (UX §2) -->
        <Border Grid.Row="3" Height="24" Background="#0A1F45" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="120" Height="6" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                 Foreground="{StaticResource YlCoral}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource YlCoral}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CacheAgeText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastDeltaText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toasts (UX §10): bottom-right, up to 3, above the content, below the palette -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12" IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,6,0,0" MinWidth="280" MaxWidth="420"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            b:HoverBehavior.Track="True" b:HoverBehavior.IsHovered="{Binding IsHovered, Mode=TwoWay}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding DismissCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Opacity="0.7" />
                            </Button>
                            <ui:HyperlinkButton DockPanel.Dock="Right" Content="{Binding UndoLabel}" Command="{Binding UndoCommand}" Padding="8,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Command palette overlay (UX §3): last child so it paints above the content and status bar. -->
        <views:PaletteOverlay Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Palette}"
                              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <!-- Modal dialogs (UX §2): above everything, including the palette, because a confirm must be answered. -->
        <views:DialogOverlay Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Dialogs}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
    </Grid>
</ui:FluentWindow>
