<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:pages="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels.Pages">
    <!-- Settings (UX §12). Merged after UserPage.xaml: reuses SectionTitle, Caption, FactLabel, FactValue, CopyableMono. -->

    <DataTemplate x:Key="PermissionRowTemplate" DataType="{x:Type pages:PermissionRow}">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon x:Name="Icon" Symbol="CheckmarkCircle24" FontSize="16" Foreground="{StaticResource YlSuccess}" VerticalAlignment="Top" Margin="0,2,0,0" />

            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Requested only when you click the reveal button">
                        <TextBlock Text="Sensitive" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding ScopeList}" FontFamily="{StaticResource YlMono}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Visibility="{Binding Reason, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,4,8,0" Visibility="{Binding IsGranting, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Grant" Appearance="Primary" Command="{Binding GrantCommand}" Padding="12,4"
                           Visibility="{Binding NeedsConsent, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding Title}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding NeedsConsent}" Value="True">
                <Setter TargetName="Icon" Property="Symbol" Value="LockClosed24" />
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource YlTextSecondary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasRoleWarning}" Value="True">
                <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                <Setter TargetName="Icon" Property="Foreground" Value="#E0A030" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24" MaxWidth="860" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

                <!-- Account -->
                <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="Signed in as" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontFamily="{StaticResource YlMono}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Grid.Row="1" Text="Tenant" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantName}" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Grid.Row="2" Text="Licence" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseText}" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Grid.Row="3" Text="Directory roles" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RolesText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Sign out" Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="Removes the saved token from this machine" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Sync (UX §12) -->
                <TextBlock Text="Sync" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Delta interval" Style="{StaticResource FactLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="160" Margin="0,0,0,6"
                              ItemsSource="{Binding DeltaChoices}" SelectedItem="{Binding DeltaIntervalSeconds}"
                              AutomationProperties.Name="Delta interval">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource Seconds}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Device refresh" Style="{StaticResource FactLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="160"
                              ItemsSource="{Binding DeviceRefreshChoices}" SelectedItem="{Binding DeviceRefreshIntervalSeconds}"
                              AutomationProperties.Name="Device refresh interval">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource Seconds}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Rebuild index" Command="{Binding RebuildIndexCommand}" IsEnabled="{Binding IsRebuilding, Converter={StaticResource InverseBool}}"
                               AutomationProperties.Name="Rebuild the local index" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="Discards the cache and reads this tenant again" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Appearance (UX §12) -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Theme" Style="{StaticResource FactLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="160" Margin="0,0,0,6" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                              AutomationProperties.Name="Theme" />
                    <TextBlock Grid.Row="1" Text="Density" Style="{StaticResource FactLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="160" ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}"
                              AutomationProperties.Name="Density" />
                </Grid>

                <!-- Permissions (UX §12) -->
                <TextBlock Text="Permissions" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Read permissions were granted at sign-in. Write permissions are requested the first time you change something, and sensitive ones only when you click a reveal button."
                           Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Content="Grant all write permissions" Command="{Binding GrantAllWriteCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding GrantedSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,10"
                            IsOpen="{Binding ConsentError, Converter={StaticResource NullToBool}, Mode=OneWay}"
                            Message="{Binding ConsentError}" />
                <ItemsControl ItemsSource="{Binding Permissions}" ItemTemplate="{StaticResource PermissionRowTemplate}" />

                <!-- Diagnostics (UX §12) -->
                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Logs" Style="{StaticResource FactLabel}" />
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding LogsPath}" FontFamily="{StaticResource YlMono}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="Cache" Style="{StaticResource FactLabel}" />
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding CachePath}" FontFamily="{StaticResource YlMono}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="Activity log" Style="{StaticResource FactLabel}" />
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding ActionsPath}" FontFamily="{StaticResource YlMono}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="Cache size" Style="{StaticResource FactLabel}" />
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding CacheSizeText}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Open logs folder" Margin="0,0,8,0" Command="{Binding OpenLogsFolderCommand}" AutomationProperties.Name="Open the logs folder" />
                    <ui:Button Content="Open cache folder" Margin="0,0,8,0" Command="{Binding OpenCacheFolderCommand}" AutomationProperties.Name="Open the cache folder" />
                    <ui:Button Content="Export logs" Command="{Binding ExportLogsCommand}" AutomationProperties.Name="Export the logs" />
                </StackPanel>
                <TextBlock Text="The export is a zip of the log files. They hold object IDs and error text, never tokens or passwords."
                           Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
