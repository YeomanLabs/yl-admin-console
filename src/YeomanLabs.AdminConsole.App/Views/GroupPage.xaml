<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:pages="clr-namespace:YeomanLabs.AdminConsole.App.ViewModels.Pages"
                    xmlns:models="clr-namespace:YeomanLabs.AdminConsole.Core.Models;assembly=YeomanLabs.AdminConsole.Core">
    <!-- Group page (UX §4.5). Merged after UserPage.xaml: reuses HeaderBadge, CopyableMono, SectionTitle, Caption, SkeletonBlock. -->

    <DataTemplate x:Key="MemberRow" DataType="{x:Type models:PersonRef}">
        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.OpenMemberCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding Label}">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="Icon" Symbol="Person24" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource YlTextSecondary}" Grid.Column="2" Text="{Binding UserPrincipalName}" FontFamily="{StaticResource YlMono}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="group">
                <Setter TargetName="Icon" Property="Symbol" Value="PeopleTeam24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="device">
                <Setter TargetName="Icon" Property="Symbol" Value="Laptop24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="servicePrincipal">
                <Setter TargetName="Icon" Property="Symbol" Value="Apps24" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:GroupDetailViewModel}">
        <Grid Margin="24,16,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: name · mail · badges (kind / dynamic / synced / role-assignable) -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource YlRailBackground}" TextElement.Foreground="{StaticResource YlOnNavy}"
                        BorderBrush="{StaticResource YlCoral}" BorderThickness="2" VerticalAlignment="Top" Margin="0,2,14,0">
                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                    <Button Style="{StaticResource CopyableMono}" Content="{Binding Group.Mail}" Margin="-4,2,0,0"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding Group.Mail}" AutomationProperties.Name="Copy group mail"
                            Visibility="{Binding Group.Mail, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding Group.Description}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,2,0,0"
                               Visibility="{Binding Group.Description, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource HeaderBadge}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="6,0,6,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsHydrating, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HydrateError}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HydrateError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
                    <ui:Button Content="Add member…" IsEnabled="False" HorizontalAlignment="Right"
                               ToolTip="{Binding MembershipDisabledReason}" ToolTipService.ShowOnDisabled="True" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding MembershipDisabledReason}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Right" />
                    <TextBlock Foreground="{DynamicResource YlTextSecondary}" Text="{Binding TimingText}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,16">
                    <!-- Dynamic membership rule -->
                    <StackPanel Visibility="{Binding HasMembershipRule, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Membership rule" Style="{StaticResource SectionTitle}" />
                        <Border Padding="10,8" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left" MaxWidth="720">
                            <TextBlock Text="{Binding MembershipRule}" FontFamily="{StaticResource YlMono}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- Owners -->
                    <TextBlock Text="Owners" Style="{StaticResource SectionTitle}" />
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OwnersCaption}" Style="{StaticResource Caption}" Visibility="{Binding OwnersCaption, Converter={StaticResource NullToCollapsed}}" />
                                                <ItemsControl ItemsSource="{Binding Owners}" ItemTemplate="{StaticResource MemberRow}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOwnersLoaded}" Value="False">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SkeletonBlock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Members: cache first, then fetched on demand and paged -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MembersHeader}" Style="{StaticResource SectionTitle}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="8,16,0,6" Visibility="{Binding IsMembersLoading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MembersCaption}" Style="{StaticResource Caption}" Margin="0,0,0,4" Visibility="{Binding MembersCaption, Converter={StaticResource NullToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource MemberRow}" />
                    <TextBlock Text="This group has no members." Style="{StaticResource Caption}" Visibility="{Binding Members.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ui:Button Content="Load more" Command="{Binding LoadMoreMembersCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                               Visibility="{Binding HasMoreMembers, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
