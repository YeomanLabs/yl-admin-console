<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdminConsole.App</RootNamespace>
    <AssemblyName>AdminConsole</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.4</Version>
    <!-- The app icon (scripts/icon/New-AppIcon.py). A branded build swaps it with -p:AppIconPath=<file.ico>, which
         Build-Release.ps1 -IconPath passes; the exe, the window and the title bar all take it from here. -->
    <AppIconPath Condition="'$(AppIconPath)' == ''">Assets\AppIcon.ico</AppIconPath>
    <ApplicationIcon>$(AppIconPath)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="$(AppIconPath)" Link="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdminConsole.Core\AdminConsole.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <!-- Local overrides (a lab DC credential, say) reach Debug output only: a Release publish is what the MSI is made
         of, and Build-Release.ps1 refuses to package one that carries this file anyway. -->
    <None Update="appsettings.local.json" Condition="Exists('appsettings.local.json') And '$(Configuration)' == 'Debug'"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
