<UserControl x:Class="AdminConsole.App.Views.DialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="clr-namespace:AdminConsole.App.Behaviors"
             xmlns:dlg="clr-namespace:AdminConsole.App.ViewModels.Dialogs"
             xmlns:svc="clr-namespace:AdminConsole.App.Services"
             xmlns:tpl="clr-namespace:AdminConsole.Core.Templates;assembly=AdminConsole.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=svc:DialogService}">
    <!-- One modal at a time (UX §2): chrome comes from the base view-model, the middle is per-dialog. -->
    <UserControl.Resources>
        <!-- Confirm: optional "type the name" gate for the irreversible ones. -->
        <DataTemplate DataType="{x:Type dlg:ConfirmDialogViewModel}">
            <StackPanel Visibility="{Binding NeedsTyping, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding TypedPrompt}" FontSize="12" Margin="0,4,0,4" />
                <ui:TextBox Text="{Binding TypedValue, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{StaticResource AcMono}"
                            b:FocusBehavior.FocusWhen="{Binding NeedsTyping}"
                            AutomationProperties.Name="Type the name to confirm" />
            </StackPanel>
        </DataTemplate>

        <!-- Reset password (UX §4 header): generate or type, plus the force-change checkbox. -->
        <DataTemplate DataType="{x:Type dlg:PasswordResetDialogViewModel}">
            <StackPanel>
                <RadioButton Content="Generate a password" IsChecked="{Binding IsGenerated}" Margin="0,4,0,0" />
                <Grid Margin="24,4,0,0" Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Generated, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource AcMono}"
                                AutomationProperties.Name="Generated password" />
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Transparent" Margin="6,0,0,0"
                               Command="{Binding RegenerateCommand}" ToolTip="Generate another" AutomationProperties.Name="Generate another" />
                </Grid>

                <RadioButton Content="Type a password" IsChecked="{Binding IsTyped}" Margin="0,10,0,0" />
                <StackPanel Margin="24,4,0,0" Visibility="{Binding IsTyped, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBox Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource AcMono}"
                                b:FocusBehavior.FocusWhen="{Binding IsTyped}"
                                PlaceholderText="The password is visible on screen"
                                AutomationProperties.Name="New password" />
                    <TextBlock Text="{Binding TypedError}" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TypedError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <CheckBox Content="Require a change at next sign-in" IsChecked="{Binding ForceChangeNextSignIn}" Margin="0,12,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Show-once (UX §4): the password exists nowhere else, so say so plainly. -->
        <DataTemplate DataType="{x:Type dlg:PasswordRevealDialogViewModel}">
            <StackPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Password, Mode=OneWay}" IsReadOnly="True" FontSize="16" FontFamily="{StaticResource AcMono}"
                                b:FocusBehavior.FocusWhen="True" AutomationProperties.Name="New password" />
                    <ui:Button Grid.Column="1" Content="Copy" Margin="6,0,0,0" Command="{Binding CopyCommand}" AutomationProperties.Name="Copy password" />
                </Grid>
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Copied to the clipboard" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding ForceChangeText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- Revealed secrets (UX §5): BitLocker keys and the LAPS password, one row each with its own Copy. -->
        <DataTemplate DataType="{x:Type dlg:SecretRevealDialogViewModel}">
            <ItemsControl ItemsSource="{Binding Secrets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dlg:SecretRow}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Label}" FontSize="11" Margin="0,0,0,3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource AcMono}"
                                            AutomationProperties.Name="{Binding Label}" />
                                <ui:Button Grid.Column="1" Content="Copy" Margin="6,0,0,0" Command="{Binding CopyCommand}"
                                           AutomationProperties.Name="Copy value" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Caption}" FontSize="11" Margin="0,3,0,0"
                                       Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Copied to the clipboard" FontSize="11" Margin="0,3,0,0"
                                       Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <!-- One line of text: a template name, a profile name. -->
        <DataTemplate DataType="{x:Type dlg:TextPromptDialogViewModel}">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Prompt}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding Placeholder}"
                            b:FocusBehavior.FocusWhen="True"
                            AutomationProperties.Name="{Binding Prompt}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </StackPanel>
        </DataTemplate>

        <!-- Automatic replies (M14.4): state, schedule, two messages, who outside gets one. -->
        <DataTemplate DataType="{x:Type dlg:AutoReplyDialogViewModel}">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Automatic replies" FontSize="12" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static dlg:AutoReplyDialogViewModel.States}" SelectedItem="{Binding State}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Automatic replies" />
                <Grid Margin="0,10,0,0" Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="From" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding StartDate}" AutomationProperties.Name="Replies from" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Until the end of" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding EndDate}" AutomationProperties.Name="Replies until" />
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Reply to people inside the organisation" FontSize="12" Margin="0,10,0,4" />
                    <TextBox Text="{Binding InternalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reply to people inside the organisation" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Outside the organisation" FontSize="12" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{x:Static dlg:AutoReplyDialogViewModel.Audiences}" SelectedItem="{Binding Audience}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Outside the organisation" />
                    <TextBox Text="{Binding ExternalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140"
                             Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reply to people outside the organisation"
                             Visibility="{Binding RepliesOutside, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Language and time zone (M14.2). -->
        <DataTemplate DataType="{x:Type dlg:RegionalDialogViewModel}">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Language" FontSize="12" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Label" AutomationProperties.Name="Language" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Time zone" FontSize="12" Margin="0,10,0,4" />
                <ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding TimeZone}" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Label" AutomationProperties.Name="Time zone" />
                <CheckBox IsChecked="{Binding LocalizeFolders}" Margin="0,12,0,0"
                          Content="Also rename Inbox, Sent Items and the other default folders into the new language" />
                <TextBlock Text="Renaming folders can't be undone from here." Foreground="{DynamicResource AcTextSecondary}" FontSize="12" Margin="26,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Offboard (UX §8): one dialog, three phases. The checklist becomes the live log becomes the summary. -->
        <DataTemplate DataType="{x:Type dlg:OffboardStepRow}">
            <Border Padding="8,6" Margin="0,2,0,0" CornerRadius="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0"
                              IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                              AutomationProperties.Name="{Binding Title}" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource AcMono}" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}" />
                            <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding HasSurfaceLabel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding SurfaceLabel}" FontSize="11" />
                            </Border>
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding DurationText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ResultMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasResultMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,3,0,0"
                                      Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="10,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="Details" Margin="0,4,0,0" FontSize="11"
                                  Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                                     FontFamily="{StaticResource AcMono}" FontSize="11" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" />
                        </Expander>
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="Retry" Padding="8,2" VerticalAlignment="Top"
                               Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Retry this step" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dlg:OffboardDialogViewModel}">
            <StackPanel>
                <!-- Restore (M15.4): which snapshot, and where the AD account goes. Instead of profile and delegate. -->
                <Grid Margin="0,4,0,8" Visibility="{Binding ShowsRestoreChrome, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Snapshot" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Snapshot to restore from" />
                    <TextBlock Grid.Row="1" Foreground="{DynamicResource AcTextSecondary}" Text="AD account to" FontSize="12" VerticalAlignment="Center" Margin="0,6,8,0"
                               Visibility="{Binding HasOuChoices, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding OuChoices}" SelectedItem="{Binding SelectedOu}"
                              DisplayMemberPath="Label" AutomationProperties.Name="OU to restore the AD account to"
                              Visibility="{Binding HasOuChoices, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Phase 1 chrome: profile, delegate. Hidden once the run starts, and for a restore. -->
                <Grid Margin="0,4,0,8" Visibility="{Binding ShowsOffboardChrome, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Profile" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox MinWidth="200" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Offboarding profile" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Delegate" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DelegateLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:Button Content="Choose…" Padding="8,2" Command="{Binding ChooseDelegateCommand}" AutomationProperties.Name="Choose a delegate" />
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6,2" Margin="4,0,0,0"
                                   Command="{Binding ClearDelegateCommand}" ToolTip="Clear the delegate" AutomationProperties.Name="Clear the delegate"
                                   Visibility="{Binding ChosenDelegate, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Grid>

                <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                            IsOpen="{Binding HasProfileError, Mode=OneWay}" Message="{Binding ProfileError}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                            Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Working out what each step would change…" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" />
                </ScrollViewer>

                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,10,0,0"
                           Visibility="{Binding HasSummaryText, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <!-- Footer: this dialog draws its own, because "Run" must not close it. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsOffboardChrome, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox MinWidth="160" PlaceholderText="Save these as…" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="New profile name" />
                        <ui:Button Content="Save profile" Margin="6,0,0,0" Command="{Binding SaveProfileCommand}" AutomationProperties.Name="Save profile" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Copy log" Margin="0,0,8,0" Command="{Binding CopyLogCommand}"
                                   Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Copy the log" />
                        <ui:Button Content="Undo" Margin="0,0,8,0" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndoRun}"
                                   Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Undo the reversible steps" />
                        <ui:Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CloseCommand}"
                                   Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Cancel run" Margin="0,0,8,0" Command="{Binding CancelRunCommand}"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Cancel the run" />
                        <ui:Button Content="{Binding RunLabel}" Appearance="Danger" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                                   Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="{Binding RunLabel}" />
                        <ui:Button Content="Close" Appearance="Primary" Command="{Binding CloseCommand}"
                                   Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <!-- Create from template (doc 07 §flow): pick, fill, run, then the password once. -->
        <DataTemplate DataType="{x:Type dlg:CreateUserDialogViewModel}">
            <StackPanel>
                <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,4,0,8"
                            IsOpen="{Binding HasTemplateError, Mode=OneWay}" Message="{Binding TemplateError}" />
                <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,8"
                            IsOpen="{Binding IsHybridTenant, Mode=OneWay}" Message="{Binding HybridNote}" />

                <!-- 1. Pick a template -->
                <StackPanel Visibility="{Binding IsPickingTemplate, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="No templates yet. Open Templates from the nav rail and snapshot one from a user who already has the role."
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasNoTemplates, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Templates}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tpl:UserTemplate}">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.ChooseTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                        CommandParameter="{Binding}">
                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding CreatedFrom.Upn, StringFormat=from {0}}" FontSize="11"
                                                       Visibility="{Binding CreatedFrom, Converter={StaticResource NullToCollapsed}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Licenses.Count, StringFormat={}{0} licence(s)}" FontSize="11" />
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text=" · " FontSize="11" />
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Groups.Count, StringFormat={}{0} group(s)}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. The form -->
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="First name" FontSize="11" Margin="0,0,0,3" />
                                <ui:TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                            b:FocusBehavior.FocusWhen="True" AutomationProperties.Name="First name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Last name" FontSize="11" Margin="0,0,0,3" />
                                <ui:TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Last name" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Display name" FontSize="11" Margin="0,10,0,0" />
                        <ui:TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Display name" />

                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Sign-in name" FontSize="11" Margin="0,10,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding UpnLocal, UpdateSourceTrigger=PropertyChanged}"
                                        FontFamily="{StaticResource AcMono}" AutomationProperties.Name="Sign-in name" />
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="1" Text="@" VerticalAlignment="Center" Margin="6,0"
                                       FontFamily="{StaticResource AcMono}" />
                            <ComboBox Grid.Column="2" MinWidth="180" ItemsSource="{Binding Domains}" SelectedItem="{Binding Domain}"
                                      AutomationProperties.Name="Domain" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,6,0"
                                             Visibility="{Binding IsCheckingUpn, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding UpnMessage}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasUpnMessage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AcTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpnIsBad}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Manager" FontSize="11" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ManagerLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Button Content="Choose…" Padding="8,2" Command="{Binding ChooseManagerCommand}" AutomationProperties.Name="Choose a manager" />
                            <ui:Button Content="Clear" Padding="8,2" Margin="6,0,0,0" Command="{Binding ClearManagerCommand}" AutomationProperties.Name="Clear the manager" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dlg:CreateFieldRow}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Label}" FontSize="11" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Licences" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding Licenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dlg:CreateLicenseRow}">
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding HasSeats}"
                                                  ToolTip="{Binding BlockedReason}" ToolTipService.ShowOnDisabled="True"
                                                  AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding BlockedReason}" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           Visibility="{Binding HasBlockedReason, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="1" Text="{Binding SeatsText}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Groups" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <ui:Button Content="Add to group…" Padding="10,2" Margin="12,16,0,6" Command="{Binding AddGroupCommand}"
                                       AutomationProperties.Name="Add to group" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dlg:CreateGroupRow}">
                                    <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="12"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                            <Button Background="Transparent" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" Cursor="Hand"
                                                    FocusVisualStyle="{x:Null}" Command="{Binding RemoveCommand}"
                                                    AutomationProperties.Name="Remove from this group">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Opacity="0.75" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Running -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Text="Creating the account…" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 4. Result -->
                <StackPanel Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Result.Steps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tpl:CreateStepResult}">
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                        <Expander Header="Details" FontSize="11" Margin="0,3,0,0"
                                                  Visibility="{Binding Details, Converter={StaticResource NullToCollapsed}}">
                                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                                     FontFamily="{StaticResource AcMono}" FontSize="11" VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent" BorderThickness="0" />
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" Margin="0,12,0,0" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasResultPassword, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Temporary password — shown only here, and stored nowhere" FontSize="11" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding Result.Password, Mode=OneWay}" IsReadOnly="True" FontSize="16"
                                        FontFamily="{StaticResource AcMono}" AutomationProperties.Name="Temporary password" />
                            <ui:Button Grid.Column="1" Content="Copy" Margin="6,0,0,0" Command="{Binding CopyPasswordCommand}"
                                       AutomationProperties.Name="Copy the password" />
                        </Grid>
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Copied to the clipboard" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding IsPasswordCopied, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding SendHint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding PreviewText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <!-- This dialog draws its own footer: "Create" must not close it. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <ui:Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CloseCommand}"
                               Visibility="{Binding IsResult, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button Content="Create user" Appearance="Primary" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}"
                               Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Create the user" />
                    <ui:Button Content="Create another" Margin="0,0,8,0" Command="{Binding CreateAnotherCommand}"
                               Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Create another user" />
                    <ui:Button Content="Open user" Margin="0,0,8,0" Command="{Binding OpenCreatedUserCommand}"
                               Visibility="{Binding HasResultPassword, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Open the new user" />
                    <ui:Button Content="Close" Appearance="Primary" Command="{Binding CloseCommand}"
                               Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Backdrop: clicking it cancels, like Esc. -->
        <Border Background="#8C000000">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding Current.CancelCommand}" />
            </Border.InputBindings>
        </Border>

        <Border Width="{Binding Current.Width, FallbackValue=520}" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="20,18"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding Current.CancelCommand}" />
            </Border.InputBindings>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
            </Border.Effect>

            <Grid DataContext="{Binding Current}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Bullets}" Margin="0,0,0,6"
                                      Visibility="{Binding HasBullets, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="·" HorizontalAlignment="Center" />
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ContentControl Content="{Binding}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="{Binding CancelText}" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                               Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Appearance" Value="Danger" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
