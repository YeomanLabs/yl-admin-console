<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AdminConsole.App.Converters">
    <!-- Merged before PageTemplates.xaml: StaticResource inside a merged dictionary only sees dictionaries merged earlier. -->

    <!-- UX §1 palette. These are the neutral defaults an unbranded install paints with; AppearanceService replaces all
         five at startup from branding.json, so an installation can carry its own colours (M11.3). They are measured,
         not picked by eye: white on the chrome is 15.0:1 and the accent is 5.95:1 on chrome and 6.53:1 on the page.
         The accent is used for primary actions, focus rings and the active nav item only. -->
    <Color x:Key="AcChromeColor">#1F2733</Color>
    <Color x:Key="AcAccentColor">#58A6FF</Color>
    <SolidColorBrush x:Key="AcChrome" Color="{StaticResource AcChromeColor}" />
    <SolidColorBrush x:Key="AcAccent" Color="{StaticResource AcAccentColor}" />
    <SolidColorBrush x:Key="AcAccentDim" Color="#B358A6FF" />
    <SolidColorBrush x:Key="AcRailBackground" Color="#27313F" />
    <!-- Text drawn on the chrome. AppearanceService recomputes this from the chrome's own luminance at startup, so a
         light chrome gets dark text instead of the M8.4 failure where a hardcoded light foreground met a dark panel. -->
    <SolidColorBrush x:Key="AcOnChrome" Color="#F2F5FA" />
    <SolidColorBrush x:Key="AcSuccess" Color="#4CC38A" />
    <!-- Danger has two jobs with opposite requirements, and one brush could not do both.
         As a badge FILL it needs white text to pass: #F04E4E gave 3.56:1, #C62F2F gives 5.46:1.
         As TEXT it sits on the page or a row and needs to be light: #F04E4E measured 4.63:1 on the page but only
         3.87:1 on a row, which is where it is actually used. SystemFillColorCriticalBrush is the platform's own
         critical colour and follows the theme, so the light theme gets a dark red rather than a washed-out pink. -->
    <SolidColorBrush x:Key="AcDangerFill" Color="#C62F2F" />
    <SolidColorBrush x:Key="AcDanger" Color="#F04E4E" />
    <!-- Text levels, measured rather than assumed. WPF-UI's own TextFillColor*Brush resolve far dimmer than their
         names suggest in 3.0.5 — secondary rendered as #868686 (5.1:1) and even primary came out #999999 inside a
         button, which is how the whole app ended up grey-on-grey. These two are ours, and AppearanceService swaps
         them when the theme changes. Dark values here; see AppearanceService for light.
         Dark:  primary #FFFFFF = 16.5:1, secondary #C8C8C8 = 9.9:1 on the page.
         Light: primary #1A1A1A = 16.9:1, secondary #4A4A4A = 8.6:1 on white. -->
    <SolidColorBrush x:Key="AcTextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AcTextSecondary" Color="#C8C8C8" />
    <FontFamily x:Key="AcMono">Cascadia Mono, Consolas</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:NullToBoolConverter x:Key="NullToBool" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:SecondsConverter x:Key="Seconds" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:CountToVisibilityConverter x:Key="ZeroToVisible" />
    <conv:CountToVisibilityConverter x:Key="NonZeroToVisible" WhenNonZero="True" />
    <conv:DepthToMarginConverter x:Key="DepthToMargin" />

    <!-- Small explanatory text under a control (UX §6). Used by every page that has a reason to give. -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AcTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- ================= List pages (M9.2-9.4) =================
         Users, Groups and Devices differ only in the columns each row draws, so the chrome — heading, filter box,
         chips, sort, count, empty state and paging — is written once here and each page supplies only its rows. -->

    <Style x:Key="FilterChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <!-- Nothing would match. This used to drop the whole chip to 0.4 opacity, which took its label to
                 2.79:1 — unreadable, in order to say "not worth reading". The zero says that by itself. -->
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AcTextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A row in any list: one clickable band, so the whole row is the target rather than a link inside it. -->
    <Style x:Key="ListRowButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Without this a row inherits the button's dimmed foreground, and the name ends up darker than the sign-in
             name beneath it — the hierarchy upside down. -->
        <Setter Property="Foreground" Value="{DynamicResource AcTextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small pill for a row flag: Disabled, Guest, Dynamic, Not compliant. -->
    <Style x:Key="RowBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>



    <!-- A Home tile: a figure you can click, which opens the list already filtered to it. -->
    <Style x:Key="HomeTileButton" TargetType="Button" BasedOn="{StaticResource ListRowButton}">
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
