<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:pages="clr-namespace:AdminConsole.App.ViewModels.Pages"
                    xmlns:views="clr-namespace:AdminConsole.App.Views"
                    xmlns:tpl="clr-namespace:AdminConsole.Core.Templates;assembly=AdminConsole.Core">
    <!-- Doc 03: navigation is ContentControl + one DataTemplate per page ViewModel type. -->

    <!-- Home (M9.5). It was one sentence pointing at Ctrl+K. It is now somewhere to start from: search, the things
         people do, what is in the tenant, what is worth a look, and what you had open last. -->
    <DataTemplate DataType="{x:Type pages:HomePageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20,24,56">
                <!-- Left-aligning this panel would size it to its widest child, which made the search box as
                     narrow as its own caption. Stretching to a max width lets the search invite a click. -->
                <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding Greeting}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding TenantName}" FontSize="13" Margin="0,2,0,0" />

                    <!-- The search box is a button: clicking anywhere on it opens the palette, which is the real
                         search. A second text box that behaved differently would be worse than one that is honest. -->
                    <Button Command="{Binding SearchCommand}" Margin="0,18,0,0" HorizontalContentAlignment="Stretch"
                            Padding="14,12" Cursor="Hand" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            AutomationProperties.Name="Search users, devices and groups">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" FontSize="18" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="1" Text="Search for a person, a device or a group" Margin="10,0,0,0"
                                       FontSize="14" VerticalAlignment="Center" />
                            <Border Grid.Column="2" CornerRadius="3" Padding="6,2"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Ctrl+K" FontSize="11" FontFamily="{StaticResource AcMono}" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- First run (M9.8). Three lines, not a tour. The third is the one that matters to someone who
                         has just been handed the keys to a directory. -->
                    <Border Margin="0,20,0,0" Padding="16,14" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AcAccent}" BorderThickness="1"
                            Visibility="{Binding ShowIntro, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="New here?" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Search finds anyone or anything by name, sign-in name, serial or phone number — the box above, or Ctrl+K from anywhere." />
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="The rail on the left browses everything: users, groups and devices, with filters for the questions a helpdesk actually asks." />
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Nothing destructive happens without showing you exactly what it will change first, and most of it can be undone. Everything you change is recorded in the activity log." />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Got it" VerticalAlignment="Top" Margin="16,0,0,0"
                                       Command="{Binding DismissIntroCommand}"
                                       AutomationProperties.Name="Dismiss the introduction" />
                        </Grid>
                    </Border>

                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Start something" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <WrapPanel>
                        <ui:Button Icon="{ui:SymbolIcon PersonAdd24}" Content="New user from a template" Margin="0,0,8,8"
                                   Command="{Binding CreateUserCommand}"
                                   AutomationProperties.Name="Create a new user from a template" />
                        <ui:Button Icon="{ui:SymbolIcon PersonDelete24}" Content="Offboard someone" Margin="0,0,8,8"
                                   Command="{Binding OffboardUserCommand}"
                                   AutomationProperties.Name="Offboard someone" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Sync now" Margin="0,0,8,8"
                                   Command="{Binding SyncCommand}"
                                   AutomationProperties.Name="Sync now" />
                    </WrapPanel>

                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="In this tenant" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <ItemsControl ItemsSource="{Binding Totals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:HomeTile}">
                                <Button Style="{StaticResource HomeTileButton}" Command="{Binding OpenCommand}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CountText}" FontSize="26" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" FontSize="13" Margin="0,2,0,0" />
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Description}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="190" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Worth a look" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Nothing needs attention — no disabled accounts holding licences, no non-compliant devices, no empty groups."
                               FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               Visibility="{Binding NothingNeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Attention}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:HomeTile}">
                                <Button Style="{StaticResource HomeTileButton}" Command="{Binding OpenCommand}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CountText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AcAccent}" />
                                        <TextBlock Text="{Binding Label}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="190" />
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Description}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="190" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Where you were" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:RecentEntry}">
                                    <Button Style="{StaticResource ListRowButton}" Command="{Binding OpenCommand}"
                                            Margin="0,0,8,8" MinWidth="220"
                                            AutomationProperties.Name="{Binding Primary}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource AcTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Secondary}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <!-- UX §9 step 1: splash + Sign in with Microsoft, with the three failure states -->
    <DataTemplate DataType="{x:Type pages:SignInPageViewModel}">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                <TextBlock Text="{Binding DataContext.ProductName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding DataContext.Tagline, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" Margin="0,6,0,28" />

                <ui:InfoBar Severity="Error" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16"
                            Title="{Binding ErrorTitle}" Message="{Binding ErrorMessage}">
                    <ui:InfoBar.Content>
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorHint}" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Visibility="{Binding ErrorHint, Converter={StaticResource NullToCollapsed}}" />
                            <Expander Header="Details" Margin="0,4,0,0" Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                         FontFamily="{StaticResource AcMono}" FontSize="12" VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </ui:InfoBar.Content>
                </ui:InfoBar>

                <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Height="40" FontSize="14"
                           Content="Sign in with Microsoft" Icon="{ui:SymbolIcon Person24}"
                           Command="{Binding SignInCommand}" IsDefault="True" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding BusyText}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Personal sign-in with the Windows account broker. No service accounts, no data leaves your tenant." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,28,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- UX §9 step 2: our own scope explanation before the prompt -->
    <DataTemplate DataType="{x:Type pages:ScopesPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="0,24">
                <TextBlock Text="What the console will read" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Read-only permissions only. Write permissions are requested later, the first time you change something." TextWrapping="Wrap" Margin="0,6,0,12" />
                <ItemsControl ItemsSource="{Binding Scopes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{DynamicResource AcAccent}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Why}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Scope}" FontSize="11" FontFamily="{StaticResource AcMono}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ui:Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="Continue to sign-in" Command="{Binding ContinueCommand}" IsDefault="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Waiting for Windows sign-in…" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- UX §9 step 3: counts ticking up -->
    <DataTemplate DataType="{x:Type pages:SyncProgressPageViewModel}">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,20" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#4CC38A" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="#F04E4E" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Width="6" Height="6" Fill="#8A8A8A" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" FontFamily="{StaticResource AcMono}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Skeleton shown in a tab until its section has loaded (UX §4: each tab shows a skeleton until data arrives) -->
    <DataTemplate x:Key="SkeletonBlock">
        <StackPanel Margin="0,8,0,0">
            <Border Height="14" Width="260" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,10" />
            <Border Height="14" Width="380" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,10" />
            <Border Height="14" Width="180" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,10" />
            <Border Height="14" Width="320" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
        </StackPanel>
    </DataTemplate>

    <!-- Placeholder object page from the palette until M4 -->
    <DataTemplate DataType="{x:Type pages:ObjectPageViewModel}">
        <StackPanel Margin="24">
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Kind}" FontSize="12" />
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Secondary}" FontFamily="{StaticResource AcMono}" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="3" Padding="6,1" Margin="0,0,4,0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding}" FontSize="11" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Id}" FontFamily="{StaticResource AcMono}" FontSize="12" Margin="0,16,0,0" />
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding ArrivesIn}" Margin="0,8,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding ArrivesIn}" Margin="0,8,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Templates (M7.2): saved templates on the left, the file itself on the right. -->
    <DataTemplate DataType="{x:Type pages:TemplatesPageViewModel}">
        <!-- Bottom margin leaves the toast stack (UX §10, bottom-right) somewhere to sit that is not on top of Save. -->
        <Grid Margin="24,16,24,56">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Templates" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ui:Button Content="New from user…" Icon="{ui:SymbolIcon PersonAdd24}" Margin="16,0,0,0"
                           Command="{Binding NewFromUserCommand}" AutomationProperties.Name="New template from user" />
                <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0"
                           Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}"
                           AutomationProperties.Name="Delete template" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                            IsOpen="{Binding HasLoadError, Mode=OneWay}" Message="{Binding LoadError}" />
                <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,8"
                            IsOpen="{Binding IsHybridTenant, Mode=OneWay}" Message="{Binding HybridNote}" />
            </StackPanel>

            <Border Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" CornerRadius="6" Padding="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="No templates yet. Snapshot one from a user who already has the role."
                               TextWrapping="Wrap" FontSize="12" Margin="10" VerticalAlignment="Top"
                               Visibility="{Binding TemplatesList.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ListBox ItemsSource="{Binding TemplatesList}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Templates"
                             Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type tpl:UserTemplate}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding CreatedFrom.Upn}" FontSize="11"
                                               FontFamily="{StaticResource AcMono}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding CreatedFrom, Converter={StaticResource NullToCollapsed}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Licenses.Count, StringFormat={}{0} licence(s)}" FontSize="11" />
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text=" · " FontSize="11" />
                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Groups.Count, StringFormat={}{0} group(s)}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Text="{Binding Json, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource AcMono}" FontSize="12" Padding="10"
                         IsEnabled="{Binding HasSelection}"
                         AutomationProperties.Name="Template JSON" />

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <ui:Button Content="Revert" Margin="0,0,8,0" Command="{Binding RevertCommand}" IsEnabled="{Binding HasSelection}" />
                        <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Users (M9.2). Row order: who they are, what they do, then the flags that decide what can be done to them. -->
    <DataTemplate DataType="{x:Type pages:UsersPageViewModel}">
        <views:ListPageView>
            <views:ListPageView.RowsContent>
                <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:UserRow}">
                        <Button Style="{StaticResource ListRowButton}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Primary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource AcTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Upn}" FontSize="11" FontFamily="{StaticResource AcMono}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding JobTitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Department}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource RowBadge}" Background="{StaticResource AcDangerFill}"
                                            Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="Disabled" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding IsGuest, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Guest" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding Licensed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="Unlicensed" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding Synced, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Mastered in on-prem AD — most attributes are read-only until Phase 2">
                                        <TextBlock Text="From AD" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </views:ListPageView.RowsContent>
        </views:ListPageView>
    </DataTemplate>

    <!-- Devices (M9.3). Entra and Intune in one list; an Entra-only row shows the gap rather than hiding it. -->
    <DataTemplate DataType="{x:Type pages:DevicesPageViewModel}">
        <views:ListPageView>
            <views:ListPageView.RowsContent>
                <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:DeviceRow}">
                        <Button Style="{StaticResource ListRowButton}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Primary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource AcTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding SubtitleText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding OwnerText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding OsText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="2" Text="{Binding LastSeenText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource RowBadge}" Background="{StaticResource AcDangerFill}"
                                            Visibility="{Binding IsNonCompliant, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Not compliant" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding IsEntraOnly, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Registered in Entra but never enrolled in Intune — no compliance state and no remote actions">
                                        <TextBlock Text="Not in Intune" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding IsUnencrypted, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Not encrypted" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </views:ListPageView.RowsContent>
        </views:ListPageView>
    </DataTemplate>

    <!-- Groups (M9.4). The badges are the ones that decide whether membership can be changed here at all. -->
    <DataTemplate DataType="{x:Type pages:GroupsPageViewModel}">
        <views:ListPageView>
            <views:ListPageView.RowsContent>
                <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:GroupRow}">
                        <Button Style="{StaticResource ListRowButton}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Primary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource AcTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Mail}" FontSize="11" FontFamily="{StaticResource AcMono}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Mail, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="1" Text="{Binding Description}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />

                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Grid.Column="2" Text="{Binding MemberCountText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource RowBadge}">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding Dynamic, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Membership comes from a rule — members cannot be added or removed by hand">
                                        <TextBlock Text="Dynamic" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding Synced, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Mastered in on-prem AD — membership is changed in AD until Phase 2">
                                        <TextBlock Text="From AD" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource RowBadge}"
                                            Visibility="{Binding RoleAssignable, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Can hold a directory role — changing it needs Privileged Role Administrator">
                                        <TextBlock Text="Role-assignable" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </views:ListPageView.RowsContent>
        </views:ListPageView>
    </DataTemplate>


    <!-- First-run setup (M10.2): which app registration does this installation sign in with? -->
    <DataTemplate DataType="{x:Type pages:SetupPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,32">
                <TextBlock Text="Connect to your tenant" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"
                           Text="This console signs in through an app registration in your own Entra tenant. It needs the client ID of that registration once; after that it remembers." />

                <Border Margin="0,20,0,0" Padding="14,12" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Don't have one yet?" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="Run this from the repository, signed in as someone who can create an app registration. It creates one in your tenant, asks for the permissions this console uses, and prints the client ID. Run it with -WhatIf first to see what it would do without changing anything." />
                        <Border CornerRadius="4" Padding="8,6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding ScriptCommand}" FontFamily="{StaticResource AcMono}" FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Client ID" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,4" />
                <ui:TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="00000000-0000-0000-0000-000000000000"
                            FontFamily="{StaticResource AcMono}"
                            AutomationProperties.Name="Client ID of the app registration" />
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" Text="{Binding ClientIdError}"
                           Visibility="{Binding ClientIdError, Converter={StaticResource NullToCollapsed}}" />

                <CheckBox Content="Only allow sign-in from one tenant" IsChecked="{Binding SingleTenant}" Margin="0,16,0,0"
                          AutomationProperties.Name="Restrict sign-in to a single tenant" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="Leave this off unless the registration was created with -SingleTenant. The default works for any tenant." />
                <ui:TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" Margin="24,6,0,0"
                            PlaceholderText="contoso.onmicrosoft.com, or the tenant GUID"
                            AutomationProperties.Name="Tenant"
                            Visibility="{Binding SingleTenant, Converter={StaticResource BoolToVisibility}}" />

                <ui:Button Appearance="Primary" Content="Save and continue" HorizontalAlignment="Stretch" Height="38"
                           Margin="0,22,0,0" Command="{Binding SaveCommand}"
                           AutomationProperties.Name="Save the registration and continue" />

                <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,16,0,0"
                           Text="Nothing is sent anywhere by saving this. It is written to your own machine, and the console still signs in as you." />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Saved: the client ID is read when the auth client is built, so it takes a restart. -->
    <DataTemplate DataType="{x:Type pages:SetupSavedViewModel}">
        <StackPanel MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource AcSuccess}" />
            <TextBlock Text="Registration saved" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Foreground="{DynamicResource AcTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"
                       Text="Close the console and start it again to sign in. It reads the registration once, when it starts." />
        </StackPanel>
    </DataTemplate>

    <!-- Activity log (M8.2): every write this admin made, filtered, and copyable as markdown. -->
    <DataTemplate DataType="{x:Type pages:ActivityPageViewModel}">
        <Grid Margin="24,16,24,56">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Activity log" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                          AutomationProperties.Name="Object kind" />
                <ComboBox Grid.Column="1" MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Outcomes}" SelectedItem="{Binding Outcome}"
                          AutomationProperties.Name="Outcome" />
                <ComboBox Grid.Column="2" MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}"
                          AutomationProperties.Name="Time range" />
                <ui:TextBox Grid.Column="3" Margin="0,0,8,0" PlaceholderText="Filter by name, action or text"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Filter the activity log" />
                <ui:Button Grid.Column="4" Content="Clear" Margin="0,0,8,0" Command="{Binding ClearFiltersCommand}"
                           AutomationProperties.Name="Clear all filters" />
                <ui:Button Grid.Column="5" Content="Copy as markdown" Command="{Binding CopyAsMarkdownCommand}" IsEnabled="{Binding HasRows}"
                           AutomationProperties.Name="Copy the log as markdown" />
            </Grid>

            <Border Grid.Row="2" CornerRadius="6" Padding="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="Nothing matches these filters. Writes appear here as you make them."
                               TextWrapping="Wrap" FontSize="12" Margin="10" VerticalAlignment="Top"
                               Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:ActivityRow}">
                                    <Border Padding="10,7" Margin="0,0,0,2" CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding WhenText}" FontSize="11" VerticalAlignment="Top" Margin="0,1,8,0" />

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ActionText}" FontSize="12" FontFamily="{StaticResource AcMono}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding CorrelationText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasCorrelation, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <ui:HyperlinkButton Content="{Binding TargetName}" Command="{Binding OpenCommand}" Padding="0"
                                                                    HorizontalAlignment="Left" AutomationProperties.Name="{Binding TargetName}" />
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding OutcomeText}" FontSize="11" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AcTextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="undone" FontSize="11" HorizontalAlignment="Right"
                                                           Visibility="{Binding WasUndone, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================= Domain (M12.3) =================
         On-prem AD. Not a list page: an admin thinks in OUs here, so the tree is a first-class part of the screen
         rather than a filter chip. Being off the corporate network is the normal state of a laptop, so an
         unreachable domain is a stated reason, not an empty list. -->
    <DataTemplate DataType="{x:Type pages:DomainPageViewModel}">
        <Grid Margin="24,16,24,56">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding CountText}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="Loading"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding SubtitleText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding SubtitleText}" />
            </StackPanel>

            <!-- Not connected: the whole page is the reason why. -->
            <Border Grid.Row="1" CornerRadius="6" Padding="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="No domain controller in reach" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding SubtitleText}" FontSize="12" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" FontSize="12" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="On-prem features need line of sight to a domain controller and a domain named in the OnPrem section of appsettings.json. Everything in the cloud half of the console works without one." />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The OU tree, drawn as a flat indented list (see DepthToMarginConverter). -->
                <Border CornerRadius="6" Padding="4" Margin="0,0,12,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,6">
                            <TextBlock Text="Organisational units" FontSize="12" FontWeight="SemiBold" />
                            <ui:HyperlinkButton Content="Show the whole domain" Padding="0" FontSize="11" HorizontalAlignment="Left"
                                                Command="{Binding ClearOuFilterCommand}"
                                                Visibility="{Binding HasOuFilter, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Clear the OU filter" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OuList}" AutomationProperties.Name="Organisational units">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListRowButton}" Padding="6,4"
                                                Command="{Binding DataContext.FilterToOuCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,6,0" Opacity="0.8" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                                  AutomationProperties.Name="What to list" />
                        <ui:TextBox Grid.Column="1" PlaceholderText="Search this domain"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    AutomationProperties.Name="Search this domain" />
                    </Grid>

                    <TextBlock Grid.Row="1" Foreground="{DynamicResource AcTextSecondary}" Text="{Binding ScopeText}" FontSize="11" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ScopeText}" />

                    <Border Grid.Row="2" CornerRadius="6" Padding="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="20"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding EmptyText}" FontSize="14" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding EmptyText}" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:DomainRow}">
                                            <Button Style="{StaticResource ListRowButton}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Primary}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="280" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource AcTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Secondary}" FontSize="11"
                                                                   FontFamily="{StaticResource AcMono}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Border Style="{StaticResource RowBadge}" Background="{StaticResource AcDangerFill}"
                                                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Disabled" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <Border Style="{StaticResource RowBadge}"
                                                                Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>


    <!-- ================= One AD object (M12.6, M12.11) =================
         For somebody who exists only in AD this is their whole page, so it carries what ADUC's tabs carry: every
         attribute editable in place, the account options, expiry, manager, membership, and the password. Users,
         groups and computers share the page because in AD they are the same object with different attributes.
         Every action a domain controller might refuse asks first where it can, and says what happened where it
         cannot. -->
    <DataTemplate DataType="{x:Type pages:DomainObjectViewModel}">
        <Grid Margin="24,16,24,56">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="Working"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Location}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Gone: the object was deleted or the DC went away. Said plainly rather than shown as an empty page. -->
            <Border Grid.Row="1" CornerRadius="6" Padding="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsPresent, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding MissingReason}" FontSize="13" TextWrapping="Wrap" MaxWidth="460"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding MissingReason}" />
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsPresent, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== Left: what it is, and everything editable about it ===== -->
                    <StackPanel Margin="0,0,16,0">

                        <!-- The read-only lines -->
                        <Border CornerRadius="6" Padding="16"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:FactRow}">
                                        <Grid MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- The editable attribute sheet (M12.11), in the same rows the User 360 identity tab uses:
                             edit on blur, a spinner then a check, no Save button. -->
                        <Border CornerRadius="6" Padding="16" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasSections, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:EditableSection}">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{DynamicResource EditableFieldRow}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Member of (M12.11), for users and computers -->
                        <Border CornerRadius="6" Padding="12" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasMembership, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Member of" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,8" />
                                <ItemsControl ItemsSource="{Binding MemberOf}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:AdMembershipRow}">
                                            <Grid MinHeight="32" Margin="4,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="Remove" FontSize="12" Padding="10,4"
                                                           Command="{Binding DataContext.RemoveFromGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanRemove}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Remove from {0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,8" Text="{Binding NoMembershipText}"
                                           Visibility="{Binding MemberOf.Count, Converter={StaticResource ZeroToVisible}}" />
                                <Grid Margin="4,6,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding GroupTarget}" DisplayMemberPath="Primary"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Group to add to" />
                                    <ui:Button Grid.Column="1" Content="Add to group" Margin="8,0,0,0" Command="{Binding AddToGroupCommand}"
                                               AutomationProperties.Name="Add to the chosen group" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- A group's direct members -->
                        <Border CornerRadius="6" Padding="8" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Direct members" FontSize="12" FontWeight="SemiBold" Margin="8,4,0,6" />
                                <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="30" Margin="8,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource AcTextSecondary}" Text="{Binding Kind}" FontSize="11" Width="76" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2" Style="{StaticResource RowBadge}" Background="{StaticResource AcDangerFill}"
                                                        Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock Text="Disabled" FontSize="11" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Right: what can be done to it ===== -->
                    <StackPanel Grid.Column="1">

                        <!-- Account (users and computers) -->
                        <Border CornerRadius="6" Padding="14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasAccountPanel, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Account" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ui:Button Content="{Binding EnableLabel}" HorizontalAlignment="Stretch" Command="{Binding ToggleEnabledCommand}"
                                           AutomationProperties.Name="{Binding EnableLabel}" />

                                <!-- Users: the rest of ADUC's Account tab (M12.11) -->
                                <StackPanel Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                    <ui:Button Content="Reset password…" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                               Command="{Binding ResetPasswordCommand}" AutomationProperties.Name="Reset the password" />

                                    <ui:Button Content="Unlock account" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                               Command="{Binding UnlockCommand}" AutomationProperties.Name="Unlock the account" />
                                    <!-- UX §6: the unlock button is greyed when there is nothing to unlock, and says so. -->
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding LockoutText}" />

                                    <ui:Button Content="{Binding PasswordExpiryLabel}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                               Command="{Binding TogglePasswordNeverExpiresCommand}"
                                               AutomationProperties.Name="{Binding PasswordExpiryLabel}" />
                                    <ui:Button Content="{Binding MustChangeLabel}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                               Command="{Binding ToggleMustChangeCommand}"
                                               AutomationProperties.Name="{Binding MustChangeLabel}" />

                                    <TextBlock Text="Account expires" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" />
                                    <TextBlock Text="{Binding AccountExpiresText}" FontSize="13" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding NewExpiryText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="yyyy-mm-dd"
                                                    AutomationProperties.Name="New expiry date" />
                                        <ui:Button Grid.Column="1" Content="Set" Margin="8,0,0,0" Command="{Binding SetExpiryCommand}"
                                                   AutomationProperties.Name="Set the account expiry" />
                                    </Grid>
                                    <ui:Button Content="Never expires" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                               Command="{Binding ClearExpiryCommand}" AutomationProperties.Name="Clear the account expiry" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Text="Expiry is the end of the given day, as in ADUC." />
                                </StackPanel>

                                <!-- Computers -->
                                <StackPanel Visibility="{Binding IsComputer, Converter={StaticResource BoolToVisibility}}">
                                    <ui:Button Content="Reveal LAPS password" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                               Command="{Binding RevealLapsCommand}" AutomationProperties.Name="Reveal the LAPS password" />
                                    <ui:Button Content="Reset account…" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                               Command="{Binding ResetComputerAccountCommand}" AutomationProperties.Name="Reset the machine account" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Text="Reset account is the fix for a broken trust relationship. The machine must rejoin afterwards." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Manager (users) -->
                        <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Manager" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ManagerText}" FontSize="13" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding ManagerTarget}" DisplayMemberPath="Primary"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="New manager" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="Set manager" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                               Command="{Binding SetManagerCommand}" AutomationProperties.Name="Set the chosen person as manager" />
                                    <ui:Button Grid.Column="1" Content="Clear" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                               Command="{Binding ClearManagerCommand}" AutomationProperties.Name="Clear the manager" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group scope and category (M12.5) -->
                        <Border CornerRadius="6" Padding="14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Scope and category" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Group scope" />
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                          AutomationProperties.Name="Group category" />
                                <ui:Button Content="Convert" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding ConvertCommand}"
                                           AutomationProperties.Name="Convert the group" />
                                <!-- UX §6: a control that cannot be used says why, beside it. -->
                                <TextBlock Text="{Binding ConversionBlockedReason}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding ConversionBlockedReason, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <!-- Move -->
                        <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Move" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding OrganisationalUnits}" SelectedItem="{Binding MoveTarget}"
                                          DisplayMemberPath="DistinguishedName" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Organisational unit to move to" />
                                <ui:Button Content="Move here" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding MoveCommand}"
                                           AutomationProperties.Name="Move to the chosen organisational unit" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="The object keeps its objectGUID, so anything that refers to it stays valid." />
                            </StackPanel>
                        </Border>

                        <!-- Rename -->
                        <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Rename" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New name"
                                            AutomationProperties.Name="New name" />
                                <ui:Button Content="Rename" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding RenameCommand}"
                                           AutomationProperties.Name="Rename this object" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="This changes the object's name only. The sign-in name is left alone." />
                            </StackPanel>
                        </Border>

                        <!-- Delete, last and on its own -->
                        <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{StaticResource AcDanger}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="Unless the recycle bin is enabled on this forest, deleting cannot be undone. You will be asked to type the name." />
                                <ui:Button Content="Delete from Active Directory" HorizontalAlignment="Stretch"
                                           Appearance="Danger" Command="{Binding DeleteCommand}"
                                           AutomationProperties.Name="Delete this object from Active Directory" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
